---
import "../styles/global.css";

const projects = [
  {
    number: "01",
    category: "SPORT · BRAND CAMPAIGN",
    title: "A story in motion",
    description: "A campaign built around movement, competition and human moments.",
    visual: "visual-one",
    status: "PROJECT TITLE / REPLACE"
  },
  {
    number: "02",
    category: "FILM · CREATIVE PRODUCTION",
    title: "Beyond the frame",
    description: "From the first creative thought to the final frame.",
    visual: "visual-two",
    status: "PROJECT TITLE / REPLACE"
  },
  {
    number: "03",
    category: "SPORT · CONTENT SERIES",
    title: "The next chapter",
    description: "A visual story shaped by energy, precision and personality.",
    visual: "visual-three",
    status: "PROJECT TITLE / REPLACE"
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101010" />
    <meta name="description" content="Portfolio of Francesco Dessabo — Creative Producer and Filmmaker." />
    <title>Francesco Dessabo — Creative Producer & Filmmaker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="#top" aria-label="Francesco Dessabo home">FD<span>®</span></a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="#work">Selected work</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>
        <a class="availability" href="mailto:hello@francescodessabo.com">
          <span class="availability-dot"></span>
          Available for selected projects
        </a>
        <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span></span><span></span>
        </button>
      </header>

      <main id="top">
       
<section class="hero">

  <!-- Background video -->
  <div class="hero-reel" aria-label="Featured film">
    <iframe
      src="https://player.vimeo.com/video/1245252910?h=c315b8a396&background=1&autoplay=1&muted=1&loop=1&autopause=0"
      title="Francesco Dessabo — Featured Film"
      frameborder="0"
      allow="autoplay; fullscreen; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>

  <!-- Small introductory labels -->
  <div class="hero-topline reveal">
    <span>INDEPENDENT CREATIVE PORTFOLIO</span>
    <span>BASED IN LONDON · WORKING WORLDWIDE</span>
  </div>

  <!-- Main headline -->
  <div class="hero-copy reveal">
    <p class="eyebrow">CREATIVE PRODUCER & FILMMAKER</p>
    <h1>Ideas into<br /><em>experiences.</em></h1>

    <div class="hero-bottom">
      <p class="hero-intro">
        I shape and produce visual stories for brands, sport and culture — from the first idea to the final frame.
      </p>

      <a class="text-link" href="#work">
        Explore selected work <span>↘</span>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-note">
    <span class="scroll-line"></span>
    SCROLL TO EXPLORE
  </div>

</section>


        <section class="work-section section-pad" id="work">
          <div class="section-heading reveal">
            <div>
              <p class="eyebrow">01 / SELECTED WORK</p>
              <h2>Made to<br /><em>make you feel.</em></h2>
            </div>
            <p class="section-aside">A selection of creative projects, films and campaigns. Each one starts with a question: what can this become?</p>
          </div>

          <div class="project-grid">
            {projects.map((project) => (
              <article class="project-card reveal">
                <a class={`project-visual ${project.visual}`} href="#contact" aria-label={`Discuss ${project.title}`}>
                  <span class="project-index">{project.number} / 03</span>
                  <span class="project-status">{project.status}</span>
                  <span class="project-visual-title">{project.title}</span>
                  <span class="project-open">↗</span>
                </a>
                <div class="project-meta">
                  <div>
                    <p class="project-category">{project.category}</p>
                    <h3>{project.title}</h3>
                  </div>
                  <p>{project.description}</p>
                </div>
              </article>
            ))}
          </div>
          <p class="content-note">PROJECTS SHOWN ARE PLACEHOLDERS — WE'LL REPLACE THESE WITH YOUR SELECTED WORK.</p>
        </section>

        <section class="statement-section">
          <p class="eyebrow reveal">02 / THE APPROACH</p>
          <p class="statement reveal">Good work starts with <em>curiosity.</em><br />Great work happens when<br />the details come together.</p>
          <div class="statement-bottom reveal">
            <span>CREATIVE THINKING. THOUGHTFUL PRODUCTION. MEANINGFUL STORIES.</span>
            <span>01 — 03</span>
          </div>
        </section>

      
<section class="about-section section-pad" id="about">
  <div class="about-label reveal">
    <p class="eyebrow">03 / A LITTLE ABOUT ME</p>
    <span class="about-mark">FD.</span>
  </div>
  <div class="about-copy reveal">
    <h2>About <em>me.</em></h2>
    <p class="about-body">
      I'm a Creative Producer and Filmmaker driven by the power of visual storytelling.
      Working across brands, sport and culture, I bring ideas to life through creative thinking,
      thoughtful production and a passion for filmmaking.
    </p>
  </div>
</section>


        <section class="contact-section section-pad" id="contact">
          <p class="eyebrow reveal">04 / HAVE A PROJECT IN MIND?</p>
          <div class="contact-main reveal">
            <h2>Let's make<br /><em>something matter.</em></h2>
            <a class="contact-link" href="mailto:hello@francescodessabo.com">Get in touch <span>↗</span></a>
          </div>
          <footer class="site-footer">
            <a class="wordmark" href="#top">FD<span>®</span></a>
            <span>CREATIVE PRODUCER · FILMMAKER</span>
            <span>© {new Date().getFullYear()} FRANCESCO DESSABO</span>
            <a href="#top">BACK TO TOP ↑</a>
          </footer>
        </section>
      </main>
    </div>

    <script>
      const menuButton = document.querySelector(".menu-toggle");
      const nav = document.querySelector(".desktop-nav");
      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        nav?.classList.toggle("nav-open", !isOpen);
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
